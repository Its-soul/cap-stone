# Public Spaces can be attempted anonymously. Leave empty for anonymous calls.
# Optional Hugging Face READ token; never commit .env or paste tokens into results.
HF_TOKEN=

# Reviewed NLI pipeline on ZeroGPU; a different model from the project checkpoint.
# Alternate reviewed free remote CPU profile: nli-cpu
REMOTE_PROFILE=nli-zero-gpu
REMOTE_TIMEOUT_SECONDS=120
